# ============================================================
# Anzato — Apache config, FINAL (HTTPS)
#
# This is the live config now that the ZeroSSL certificate is
# installed. It forces HTTPS, folds www into the bare domain, and
# keeps /.well-known/ above the redirect so certificate renewal
# cannot be caught by it.
#
# If anything ever breaks, rename this file to htaccess-off and the
# site falls back to plain serving. Always reversible.
# ============================================================

# ---------- 1. Let certificate validation and renewal through ----------
# MUST come before the HTTPS redirect. ZeroSSL certificates are
# 90-day, and renewal re-validates over plain HTTP at
# /.well-known/. If the redirect catches that request first,
# renewal can fail and the certificate silently lapses.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^\.well-known/ - [L]

  # ---------- 2. Force HTTPS ----------
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ---------- 3. Drop www ----------
  # The canonical tag, OG tags and sitemap all declare
  # https://anzato.com/ (no www), so everything funnels there.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# ---------- 4. Default document ----------
DirectoryIndex index.html

# ---------- 5. Don't let anyone browse folders ----------
Options -Indexes

# ---------- 6. Compression ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------- 7. Browser caching ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 1 hour"
  ExpiresByType text/css                  "access plus 1 month"
  ExpiresByType application/javascript    "access plus 1 month"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 year"
</IfModule>

# ---------- 8. Correct MIME types ----------
<IfModule mod_mime.c>
  AddType image/svg+xml   .svg
  AddType application/xml .xml
</IfModule>

# ---------- 9. Security headers ----------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # HSTS: switch on only after HTTPS has been stable for a few
  # weeks. It tells browsers to refuse plain HTTP for a year,
  # which is painful to undo if a certificate ever lapses. With a
  # 90-day ZeroSSL certificate, be confident renewal is working
  # before enabling this.
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ---------- 10. Keep internal files private ----------
<FilesMatch "\.(md|ipynb|py|env|log|bak)$">
  Require all denied
</FilesMatch>
